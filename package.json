{
  "name": "@spacesops/pear-wrk-wdk",
  "version": "1.1.1-beta.42",
  "description": "Spacesops WDK worklet bundle for React Native Bare (EVM, Spark, Bitcoin)",
  "main": "index.js",
  "scripts": {
    "build:types": "tsc --noEmit",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "gen:wallet-modules": "node scripts/generate-wallet-modules.js",
    "gen:hrpc": "node scripts/generate-hrpc.js",
    "gen:macos-bundle": "npm run gen:wallet-modules && npm run gen:hrpc && node scripts/resolve-pack-imports.js && bare-pack --target darwin-arm64 --linked --out generated/bundle/wdk-worklet.bundle.js src/wdk-worklet.js",
    "gen:mobile-bundle": "npm run gen:wallet-modules && npm run gen:hrpc && node scripts/resolve-pack-imports.js && bare-pack --target ios-arm64 --target ios-arm64-simulator --target ios-x64-simulator --target android-arm --target android-arm64 --target android-ia32 --target android-x64 --linked --imports ./pack.imports.resolved.json --out generated/bundle/wdk-worklet.mobile.bundle.js src/wdk-worklet.js && node scripts/extract-linked-addons.mjs",
    "prepublishOnly": "npm run gen:mobile-bundle"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "@spacesops/wdk-wallet-btc": "1.0.0-beta.20",
    "@tetherto/wdk": "1.0.0-beta.15",
    "@tetherto/wdk-wallet-evm-erc-4337": "1.0.0-beta.14",
    "@tetherto/wdk-wallet-spark": "1.0.0-beta.22",
    "hrpc": "4.0.1",
    "hyperschema": "1.12.4",
    "text-encoding": "0.7.0",
    "utf-8-validate": "5.0.10"
  },
  "devDependencies": {
    "bare-ipc": "^1.1.1",
    "bare-pack": "1.5.1",
    "rimraf": "6.0.1",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "bare-crypto": "1.12.0",
    "bare-fs": "4.8.0",
    "bare-module": "6.4.0",
    "bare-module-lexer": "1.6.3",
    "bare-os": "3.9.3",
    "bare-signals": "5.0.0",
    "bare-subprocess": "5.2.3",
    "bare-tls": "3.1.8",
    "bare-tty": "5.1.2",
    "bare-url": "2.4.7",
    "bare-zlib": "1.4.1",
    "sodium-native": "5.1.0"
  },
  "files": [
    "index.js",
    "schema.json",
    "pack.imports.json",
    "src/",
    "types/",
    "generated/wallet-modules.js",
    "generated/hrpc/",
    "generated/bundle/wdk-worklet.mobile.bundle.js",
    "generated/pear-linked-addons.json"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    },
    "./src/hrpc": {
      "types": "./types/hrpc.d.ts",
      "default": "./generated/hrpc/index.js"
    },
    "./types/rpc": {
      "types": "./types/rpc.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesops/pear-wrk-wdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "SpacesOps",
  "license": "Apache-2.0",
  "standard": {
    "ignore": [
      "generated/**",
      "node_modules/**",
      "types/**",
      "**/*.d.ts",
      "bundle/**",
      "test/**"
    ]
  }
}
